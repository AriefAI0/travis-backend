# Server
PORT=8788

# Signs every session better-auth issues. Required, at least 32 characters.
# Generate one with: openssl rand -base64 32
# Rotating it signs every user out.
BETTER_AUTH_SECRET=

# Base URL better-auth builds its own links from. The default suits local dev;
# set it to the address operators reach the server on.
BETTER_AUTH_URL=http://localhost:8788

# The first admin. Seeded once, only while no account exists, so a restart
# never resets a password. Changing the password here does nothing after that.
# Password must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

#postgress urll
#postgres://<user>:<password>@<host>:<port>/<database>
# WARNING : dont use @ in password/admin - it will break
# to test : sudo apt install postgresql-client
# run on terminal : psql "postgres://postgres:postgres@localhost:5432/travis" -c "SELECT 1;"
DATABASE_URL=postgres://postgres:postgres@localhost:5432/travis


# MinIO (required — boot fails fast listing all missing)
# NOTE: docker compose overrides this to http://minio:9000 inside the stack;
# this value applies to dev (bun run dev) only.
MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Media bucket (auto-created at boot if missing; default shown).
# One bucket holds every media object: segments, stills, exports, and images.
BUCKET_MEDIA=travis-media

# Signing key for scoped playback tokens. Required, at least 32 characters.
PLAYBACK_TOKEN_SECRET=

# Browser origins allowed to fetch HLS (comma list). Dev renderer is
# localhost:5173; the packaged renderer loads from file:// and sends `null`.
# The MinIO media bucket needs the same origins — see README "CORS for playback".
CORS_ALLOWED_ORIGINS=http://localhost:5173,null

# Filmstrip grid. One still per base interval while the count fits the budget,
# then the interval doubles as a recording grows. The interval never renumbers
# what an earlier, denser grid already wrote.
THUMBNAIL_SAMPLE_BASE_MS=10000
THUMBNAIL_MAX_SAMPLES=300
