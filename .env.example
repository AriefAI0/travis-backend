# Server
PORT=8788

# MinIO (required — boot fails fast listing all missing)
# NOTE: docker compose overrides this to http://minio:9000 inside the stack;
# this value applies to dev (bun run dev) only.
MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Buckets (auto-created at boot if missing; defaults shown)
BUCKET_MASTER=travis-media
BUCKET_CLIP=travis-clip
BUCKET_HLS=travis-hls
BUCKET_MKV=travis-mkv
BUCKET_THUMBNAILS=travis-thumbs


