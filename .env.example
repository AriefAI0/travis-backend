# Server
PORT=8788

# MinIO (required — boot fails fast listing all missing)
MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Buckets (auto-created at boot if missing; defaults shown)
BUCKET_MASTER=travis-media
BUCKET_CLIP=travis-clip
BUCKET_HLS=travis-hls
BUCKET_MKV=travis-mkv
BUCKET_THUMBNAILS=travis-thumbs

# Everything else has a built-in default in src/config/env.ts —
# override here only if ever needed:
# LOG_LEVEL=info · DATA_DIR=./data · PART_SIZE_BYTES=16777216 ·
# BUFFER_CAP_BYTES=67108864 · MAX_ACTIVE_SESSIONS=4 ·
# SEGMENT_STALE_SECONDS=30 · RESUME_GRACE_MINUTES=10 ·
# PRESIGN_GET_TTL_SECONDS=604800 · FFMPEG_PATH=ffmpeg ·
# FFMPEG_CONCURRENCY=1
